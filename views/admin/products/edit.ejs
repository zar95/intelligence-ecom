<% if (locals.errors) { %>
    <div class="admin-flash admin-flash-error">⚠️ <%= errors %>
    </div>
    <% } %>

        <div class="admin-form-card">
            <div
                style="margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--dark-border);display:flex;align-items:center;gap:0.75rem">
                <span style="font-size:2rem">
                    <%= product.icon %>
                </span>
                <div>
                    <div style="font-weight:700;color:var(--text-primary)">
                        <%= product.name %>
                    </div>
                    <div style="font-size:0.8rem;color:var(--text-muted)">ID: <%= product.id %>
                    </div>
                </div>
            </div>

            <form action="/admin/products/<%= product._id %>/edit" method="POST" class="admin-form">

                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Product Name *</label>
                        <input type="text" name="name" class="admin-input" value="<%= product.name %>" required />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Brand *</label>
                        <input type="text" name="brand" class="admin-input" value="<%= product.brand %>" required />
                    </div>
                </div>

                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Price ($) *</label>
                        <input type="number" name="price" class="admin-input" value="<%= product.price %>" step="0.01"
                            required />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Was Price ($)</label>
                        <input type="number" name="was" class="admin-input" value="<%= product.was %>" step="0.01" />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Discount</label>
                        <input type="text" name="discount" class="admin-input" value="<%= product.discount %>" />
                    </div>
                </div>

                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Icon (emoji)</label>
                        <input type="text" name="icon" class="admin-input" value="<%= product.icon %>" />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Category</label>
                        <select name="category" class="admin-input admin-select">
                            <option value="">Select a Category</option>
                            <% if (locals.categories && categories.length > 0) { %>
                                <% categories.forEach(function(cat) { %>
                                    <option value="<%= cat._id %>" <%= product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Badge Text</label>
                        <input type="text" name="badge" class="admin-input" value="<%= product.badge %>" />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Badge Style</label>
                        <select name="badgeClass" class="admin-input admin-select">
                            <% [['badge-primary','Green'],['badge-danger','Red'],['badge-accent','Purple'],['badge-warning','Orange']].forEach(function(b)
                                { %>
                                <option value="<%= b[0] %>" <%=product.badgeClass===b[0] ? 'selected' : '' %>><%= b[1]
                                        %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                </div>

                <div class="admin-form-row">
                    <div class="admin-form-group" style="flex: 1;">
                        <label class="admin-label">Description</label>
                        <textarea name="description" class="admin-input" rows="4"><%= product.description %></textarea>
                    </div>
                </div>

                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Meta Keywords (SEO)</label>
                        <input type="text" name="metaKeywords" class="admin-input" value="<%= product.metaKeywordsStr %>" />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Meta Description (SEO)</label>
                        <input type="text" name="metaDescription" class="admin-input" maxlength="160" value="<%= product.metaDescription %>" />
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/products" class="btn btn-outline">Cancel</a>
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </div>

            </form>
        </div>