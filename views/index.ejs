      </a>
    </div>
  </div>
</section>

<!-- FLASH SALE -->
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="timer-bar">
      <div class="timer-label">Flash Sale — Discounts refresh every 24 hours</div>
      <div class="timer-blocks">
        <div class="timer-block">
          <div class="timer-number" data-timer="h">18</div>
          <div class="timer-unit">HRS</div>
        </div>
        <span class="timer-sep">:</span>
        <div class="timer-block">
          <div class="timer-number" data-timer="m">42</div>
          <div class="timer-unit">MIN</div>
        </div>
        <span class="timer-sep">:</span>
        <div class="timer-block">
          <div class="timer-number" data-timer="s">07</div>
          <div class="timer-unit">SEC</div>
        </div>
      </div>
    </div>

    <div class="section-header">
      <div>
        <h2 class="section-title">Today's Flash Deals</h2>
        <p class="section-subtitle">Limited stock — grab yours before it's gone</p>
      </div>
      <a href="/deals" class="btn btn-outline">See All Deals →</a>
    </div>

    <div class="product-grid">
      <% if (locals.flashProducts && flashProducts.length> 0) { %>
        <% flashProducts.forEach(function(product) { %>
          <a href="/product/<%= product.slug %>" style="text-decoration: none; color: inherit;">
            <div class="card">
              <div class="card-img" style="background: var(--dark-lighter); overflow: hidden; height: 180px; position: relative;">
                <% if (product.mainImageUrl) { %>
                  <img src="<%= product.mainImageUrl %>" alt="<%= product.name %>" style="width:100%; height:100%; object-fit:cover;" />
                <% } else { %>
                  <div style="display:flex;align-items:center;justify-content:center;height:100%;">
                    <span style="font-size:3rem;font-weight:800;color:var(--text-muted);opacity:0.3;"><%= product.name ? product.name.charAt(0).toUpperCase() : '📦' %></span>
                  </div>
                <% } %>
              </div>
              <div class="card-body">
                <% if (product.badge) { %>
                  <span class="badge <%= product.badgeClass || 'badge-accent' %> mb-1">
                    <%= product.badge %>
                  </span>
                  <% } %>
                    <div class="card-title">
                      <%= product.name %>
                    </div>
                    <div class="card-subtitle">
                      <%= product.brand %>
                    </div>
                    <div>
                      <span class="card-price">
                        <%= product.price %>
                      </span>
                      <% if (product.was) { %>
                        <span class="card-price-old">
                          <%= product.was %>
                        </span>
                        <% } %>
                    </div>
              </div>
            </div>
          </a>
          <% }); %>
            <% } else { %>
              <p>No flash deals available at the moment.</p>
              <% } %>
    </div>
  </div>
</section>

