      </a>
      <a href="/shop?category=cinema" class="category-card">

        <div class="category-name">Home Cinema</div>
        <div class="category-count">38 products</div>
      </a>
      <a href="/shop?category=photo" class="category-card">

        <div class="category-name">Photography</div>
